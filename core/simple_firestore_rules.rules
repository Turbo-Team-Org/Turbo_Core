rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /reviews/{placeId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================== FUNCIONES HELPER SIMPLIFICADAS ==================
    
    // ✅ SOLUCIÓN DIRECTA: Tu UID específico como super admin
    function isSuperAdmin() {
      return request.auth != null && 
        request.auth.uid == 'h5DpVijnICUBZUrGqY2sAUbxdR32';
    }
    
    // Función para verificar si es admin (cualquier documento en admin_users con su UID)
    function isAdmin() {
      return request.auth != null && isSuperAdmin(); // Por ahora solo super admin
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ================== BUSINESS OWNER REQUESTS ==================
    
    match /business_owner_requests/{requestId} {
      
      // CREAR: Solo usuarios autenticados pueden crear solicitudes para sí mismos
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'pending';
      
      // LEER: Super admin puede leer todas, usuarios solo las suyas
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.userId
      );
      
      // ACTUALIZAR: Solo super admins pueden actualizar solicitudes
      allow update: if isSuperAdmin();
      
      // ELIMINAR: Solo super admins
      allow delete: if isSuperAdmin();
    }

    // ================== ADMIN USERS ==================
    
    match /admin_users/{adminId} {
      allow read: if request.auth != null;
      
      // Permitir creación si es super admin
      allow create: if isSuperAdmin();
      
      allow update: if isSuperAdmin();
      
      allow delete: if isSuperAdmin();
    }

    // ================== USERS ==================
    
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
    }

    // ================== RESTO DE COLECCIONES ==================
    
    match /places/{placeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isSuperAdmin();
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null;
    }

    // Analytics collections
    match /analytics_places/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    match /analytics_reviews/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    match /analytics_traffic/{document=**} {
      allow read, write: if isSuperAdmin();
    }
    
    match /analytics_realtime/{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
} 