rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regla para las imágenes de reseñas
    match /reviews/{placeId}/{imageId} {
      allow read: if true;  // Cualquiera puede ver las imágenes
      allow write: if request.auth != null;  // Solo usuarios autenticados pueden subir
    }
  }
}

service cloud.firestore {
  match /databases/{database}/documents {

    // 👑 ADMIN USERS - Permite auto-registro de business owners
    match /admin_users/{adminId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        // Permitir auto-registro si el adminId coincide con el UID del usuario
        adminId == request.auth.uid ||
        // O si no existe ningún admin (primer setup)
        !exists(/databases/$(database)/documents/admin_users) ||
        // O si el usuario actual es super admin
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin')
      );
      allow update: if request.auth != null && (
        // El usuario puede actualizar su propio perfil
        adminId == request.auth.uid ||
        // O si es super admin (para aprobar/rechazar)
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin')
      );
      allow delete: if request.auth != null && (
        // Solo super admin puede eliminar
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin'
      );
    }

    // 👤 USERS REGULARES
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // 🏢 PLACES - Permite auto-creación por business owners
    match /places/{placeId} {
      allow read: if true; 
      allow create: if request.auth != null && (
        // Cualquier usuario autenticado puede crear lugares
        // (para auto-registro de business owners)
        true
      );
      allow update, delete: if request.auth != null && (
        // Super admin puede todo
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin') ||
        // Business owner puede editar sus lugares asignados
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         request.auth.uid in resource.data.ownerIds) ||
        // Creador puede editar su lugar
        request.auth.uid == resource.data.createdBy
      );
      
      // Sub-colección de reviews dentro de places
      match /reviews/{reviewId} {
        allow read: if true; 
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null;
      }
    }

    // 💰 OFFERS
    match /offers/{offerId} {
      allow read: if true; 
      allow create: if request.auth != null && (
        // Cualquier usuario autenticado puede crear ofertas
        true
      );
      allow update, delete: if request.auth != null && (
        // Super admin puede todo
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin') ||
        // Business owner puede gestionar ofertas de sus lugares
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         exists(/databases/$(database)/documents/places/$(resource.data.placeId)) &&
         request.auth.uid in get(/databases/$(database)/documents/places/$(resource.data.placeId)).data.ownerIds) ||
        // Creador puede editar sus ofertas
        request.auth.uid == resource.data.createdBy
      );
    }

    // 🎯 EVENTS
    match /events/{eventId} {
      allow read: if true; 
      allow create: if request.auth != null && (
        // Cualquier usuario autenticado puede crear eventos
        true
      );
      allow update, delete: if request.auth != null && (
        // Super admin puede todo
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin') ||
        // Business owner puede gestionar eventos de sus lugares
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         exists(/databases/$(database)/documents/places/$(resource.data.placeId)) &&
         request.auth.uid in get(/databases/$(database)/documents/places/$(resource.data.placeId)).data.ownerIds) ||
        // Creador del evento puede editarlo
        request.auth.uid == resource.data.createdBy
      );
    }

    // ❤️ FAVORITES
    match /favorites/{userId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth != null; 
    }

    // 📂 CATEGORIES
    match /categories/{categoryId} {
      allow read: if true; // Público para lectura
      allow create, update, delete: if request.auth != null && (
        // Solo super admins pueden modificar categorías
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin'
      );
    }

    // 🏷️ PLACE CATEGORIES
    match /place_categories/{document} {
      allow read: if true;
      allow write: if request.auth != null && (
        // Super admin puede todo
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'superAdmin')
      );
    }

    // ⭐ REVIEWS (colección principal)
    match /reviews/{reviewId} {
      allow read: if true; 
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 📊 ANALYTICS - Solo para admins
    match /analytics_places/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /analytics_traffic/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /analytics_realtime/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /analytics_reviews/{doc} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
  }
} 