# =====================================================
# TURBO CORE - CONFIGURACIÓN CON RLS POLICIES
# Copia este archivo y rellena con valores reales localmente.
# No subas claves reales al repositorio.
# =====================================================

# ENVIRONMENT CONTROL
ENVIRONMENT=staging
DATABASE_PROVIDER=supabase

# EDGE FUNCTIONS - CON RLS (servicios directos + políticas)
USE_EDGE_GATEWAY=false
SUPABASE_EDGE_BASE_URL=https://YOUR_PROJECT_REF.functions.supabase.co

# =====================================================
# SUPABASE CONFIGURATION (CON RLS POLICIES)
# =====================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# =====================================================
# FIREBASE CONFIGURATION (DEV FALLBACK)
# =====================================================
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MEASUREMENT_ID=your-measurement-id

