# ===========================================
# CONFIGURACIÓN DE TROPIPAY PARA TURBO
# ===========================================

# Credenciales de Tropipay (obtener de https://tropipay.com)
TROPIPAY_CLIENT_ID=your_client_id_here
TROPIPAY_CLIENT_SECRET=your_client_secret_here

# URL base de la API de Tropipay
# Producción: https://tropipay.com/api/v1
# Sandbox: https://sandbox.tropipay.com/api/v1
TROPIPAY_BASE_URL=https://tropipay.com/api/v1

# Secret para verificar webhooks (opcional pero recomendado)
TROPIPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Modo de prueba (true/false)
TROPIPAY_TEST_MODE=false

# URLs de retorno y cancelación
TROPIPAY_DEFAULT_RETURN_URL=https://turboapp.com/payment/success
TROPIPAY_DEFAULT_CANCEL_URL=https://turboapp.com/payment/cancel

# URL de webhook para notificaciones
TROPIPAY_DEFAULT_WEBHOOK_URL=https://turboapp.com/api/webhooks/tropipay

# Tiempo de expiración por defecto en minutos
TROPIPAY_DEFAULT_EXPIRATION_MINUTES=30

# Comisión de la plataforma (porcentaje)
PLATFORM_FEE_PERCENTAGE=2.5

# ===========================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ===========================================

# 1. Copia este archivo como .env en la raíz del proyecto Turbo_Core/core/
# 2. Reemplaza los valores con tus credenciales reales de Tropipay
# 3. Asegúrate de que el archivo .env esté en .gitignore
# 4. Para desarrollo, usa TROPIPAY_TEST_MODE=true
# 5. Para producción, usa TROPIPAY_TEST_MODE=false

# ===========================================
# CREDENCIALES DE TROPIPay
# ===========================================

# Para obtener las credenciales:
# 1. Ve a https://tropipay.com
# 2. Crea una cuenta o inicia sesión
# 3. Ve a la sección de "Desarrolladores" o "API"
# 4. Genera tus credenciales de cliente
# 5. Copia el Client ID y Client Secret aquí

# ===========================================
# WEBHOOKS
# ===========================================

# Los webhooks permiten recibir notificaciones en tiempo real
# sobre cambios en el estado de los pagos
# 
# Configura el webhook en el panel de Tropipay:
# - URL: https://tu-dominio.com/api/webhooks/tropipay
# - Eventos: payment.completed, payment.failed, payment.cancelled
# - Método: POST
# - Formato: JSON

# ===========================================
# SEGURIDAD
# ===========================================

# IMPORTANTE: Nunca subas este archivo al repositorio
# con credenciales reales. Usa variables de entorno
# en tu servidor de producción.

# Para producción, configura estas variables en tu servidor:
# - TROPIPAY_CLIENT_ID
# - TROPIPAY_CLIENT_SECRET
# - TROPIPAY_WEBHOOK_SECRET

